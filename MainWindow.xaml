<Window x:Class="desktop_watch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jam Desktop" Height="250" Width="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" MouseDown="Window_MouseDown"
        SourceInitialized="Window_SourceInitialized"
        KeyDown="Window_KeyDown" Focusable="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True" 
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    
    <Grid Background="Transparent">
        
        <Ellipse HorizontalAlignment="Center" VerticalAlignment="Center" Width="550" Height="220" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#99000000" Offset="0.0"/>
                    <GradientStop Color="#00000000" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="JamText" Text="00:00:00" Foreground="#F0F0F0" FontSize="85" FontFamily="Bahnschrift SemiBold" HorizontalAlignment="Center">
                <TextBlock.Effect><DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="2" Opacity="0.9"/></TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="TanggalText" Text="Senin, 01 Januari 2026" Foreground="#E0E0E0" FontSize="22" FontFamily="Bahnschrift Light" HorizontalAlignment="Center" Margin="0,-10,0,0">
                <TextBlock.Effect><DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="2" Opacity="0.9"/></TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="LiburText" Text="Tahun Baru" Foreground="#FF4C4C" FontSize="18" FontFamily="Bahnschrift" HorizontalAlignment="Center" Margin="0,5,0,0" Visibility="Collapsed">
                <TextBlock.Effect><DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="2" Opacity="0.9"/></TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="CuacaText" Text="⏳ Mengambil cuaca..." Foreground="#C0C0C0" FontSize="18" FontFamily="Bahnschrift Light" HorizontalAlignment="Center" Margin="0,5,0,0">
                <TextBlock.Effect><DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="2" Opacity="0.9"/></TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="CuacaStatusText" Text="" Foreground="#9A9A9A" FontSize="12" FontFamily="Bahnschrift Light" HorizontalAlignment="Center" Margin="0,2,0,0">
                <TextBlock.Effect><DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.8"/></TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <Border x:Name="LocationInputBox" Visibility="Collapsed" Background="#E6000000" CornerRadius="15" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#33FFFFFF" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="GANTI LOKASI" Foreground="#AAAAAA" FontSize="12" FontFamily="Bahnschrift SemiBold" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                <TextBox x:Name="CityTextBox" Width="250" Background="Transparent" Foreground="White" BorderThickness="0,0,0,2" BorderBrush="#888888" FontSize="24" FontFamily="Bahnschrift" CaretBrush="White" HorizontalContentAlignment="Center" KeyDown="CityTextBox_KeyDown"/>
                <TextBlock Text="Ketik nama kota, lalu tekan Enter" Foreground="#777777" FontSize="11" FontFamily="Bahnschrift Light" Margin="0,5,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>